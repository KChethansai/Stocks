{
  "name": "backend",
  "version": "1.0.0",
  "description": "Stock trading app backend",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node ml/selfcheck.js",
    "automation:once": "node ml/runOnce.js",
    "predictions:many": "node ml/runMany.js",
    "train": ".venv/bin/python -m ml.python.train",
    "train:smoke": ".venv/bin/python -m ml.python.train --synthetic",
    "train:import": ".venv/bin/python -m ml.python.import_stooq --all",
    "train:eval": ".venv/bin/python -m ml.python.evaluate"
  },
  "type": "module",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.10.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "google-auth-library": "^10.7.0",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.6.1",
    "multer": "^2.1.1",
    "node-cron": "^4.6.0",
    "yahoo-finance2": "^3.14.1"
  },
  "optionalDependencies": {
    "onnxruntime-node": "^1.29.0"
  }
}
