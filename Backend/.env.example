DB_URL=mongodb+srv://.../?retryWrites=true&w=majority
PORT=4000
SECRET_KEY=your_secret_key
CLIENT_URL=http://localhost:5173
CLIENT_URLS=http://localhost:5173,https://your-frontend.vercel.app
NODE_ENV=development
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
GOOGLE_CLIENT_ID=your_google_oauth_client_id

# ML / prediction automation
AUTOMATION_INTERVAL_CRON=*/15 * * * *
MAX_AUTOMATION_TRADES_PER_DAY=10
ACCURACY_RESOLVE_CRON=30 21 * * 1-5
# Development-only simulated accuracy presentation. NEVER true in production:
# unset or false before deploying (the server force-disables demo accuracy
# when NODE_ENV=production, but do not rely on the backstop alone).
ML_DEMO_MODE=true

# Phase 1.6 ML safety gates (fail-closed defaults — do not relax without review)
# BUY/SELL on heuristic fallback requires explicit opt-in (default: blocked)
ML_AUTOMATION_ALLOW_HEURISTIC=false
# BUY/SELL on experimental (Phase 1.5 v2) models requires explicit opt-in
ML_AUTOMATION_ALLOW_EXPERIMENTAL=false
# Quote freshness for prediction-driven trades (minutes; default 5760 = 4 days)
ML_QUOTE_MAX_AGE_MINUTES=5760
# Logs with zero candles older than this are marked unresolvable (days)
ACCURACY_UNRESOLVABLE_AFTER_DAYS=30
